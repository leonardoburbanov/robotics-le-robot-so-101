<mujoco model="scene">
    <include file="so101_new_calib.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
            height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
            rgb2="0.1 0.2 0.3"
            markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
            reflectance="0.2" />
        <material name="paper" rgba="0.96 0.96 0.96 1" />
        <material name="marker" rgba="0.95 0.82 0.05 1" />
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <camera name="overhead" pos="0.28 0 0.45" fovy="55" mode="fixed" xyaxes="1 0 0 0 1 0" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />
        <!-- 21 x 15 cm sheet, taped down. Marker is 11.7 x 2.7 x 1.5 cm, narrow side along x. -->
        <body name="paper" pos="0.28 0 0.001">
            <geom name="paper" type="box" size="0.105 0.075 0.001" material="paper" contype="0" conaffinity="0" />
            <geom name="paper_hit" type="box" pos="0 0 -0.019" size="0.105 0.075 0.02" group="3" friction="1 0.01 0.001" />
        </body>
        <body name="marker" pos="0.24 0 0.010">
            <freejoint name="marker_free" />
            <geom name="marker" type="box" size="0.0135 0.0585 0.0075" material="marker" friction="2 0.05 0.01" condim="4" />
        </body>
    </worldbody>
    <contact>
        <exclude body1="gripper" body2="marker" />
        <exclude body1="moving_jaw_so101_v1" body2="marker" />
        <exclude body1="gripper" body2="paper" />
        <exclude body1="moving_jaw_so101_v1" body2="paper" />
        <exclude body1="gripper" body2="world" />
        <exclude body1="moving_jaw_so101_v1" body2="world" />
    </contact>
</mujoco>